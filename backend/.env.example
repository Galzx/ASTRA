# Google Gemini API key (required for AI chat features)
GEMINI_API_KEY=your_gemini_api_key_here

# JWT secret for signing auth tokens (use a random 64+ char hex string)
JWT_SECRET=your_jwt_secret_here

# Admin registration key (required to create admin accounts)
ADMIN_KEY=your_admin_key_here

# Optional: daily Gemini API quota limit (default: 1500)
# GEMINI_DAILY_QUOTA=1500

# Optional: comma-separated allowed CORS origins
# CORS_ORIGINS=https://your-frontend.onrender.com,http://localhost:5173

# Optional: server port (default: 5000)
# PORT=5000
